# Dependencies
node_modules/
*/node_modules/
*/*/node_modules/

# Environment / secrets — never commit real credentials
.env
*/.env
*/*/.env
**/.env.local

# Backend uploads (user-generated content, not source)
backend/uploads/

# Downloadable APKs ARE committed (see backend/downloads/*.apk) so a normal git push
# always carries the current builds — Render's disk is not persistent, so anything not
# in git (e.g. an APK uploaded only via Admin > Settings > Publish APK) is lost on the
# next redeploy.

# Android build outputs
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
mobile/android/local.properties
*.keystore
!mobile/android/app/debug.keystore

# Vite/React build output
admin/dist/
pwa/dist/
pwa/dev-dist/
microfrontends/*/dist/

# OS / editor
.DS_Store
Thumbs.db

# Logs — including the supervisor's output folder, which also holds the current
# tunnel URL (machine-specific, regenerated on every start).
npm-debug.log*
yarn-error.log*
*.log
logs/

# Third-party CLI binary — downloaded, not source (32MB). See README's ngrok note.
tools/ngrok.exe
