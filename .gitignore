backend/downloads/*.apk

# Android build outputs
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
mobile/android/local.properties
*.keystore
!mobile/android/app/debug.keystore

# Vite/React build output
admin/dist/
pwa/dist/
pwa/dev-dist/

# OS / editor
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-error.log*
*.log
