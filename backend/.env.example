PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/munchbox
JWT_SECRET=change_this_secret
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@munchbox.com
ADMIN_PASSWORD=admin123

# Google Maps key for real road distance/ETA (delivery fee + partner ETA + shop distance).
# Enable the "Directions API" on the key in Google Cloud. Optional: without it the app
# falls back to straight-line distance. Put the REAL key in .env, not here.
GOOGLE_MAPS_API_KEY=
